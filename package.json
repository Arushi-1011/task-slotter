{
  "name": "task-slotter",
  "version": "0.1.1",
  "description": "Pure-function task scheduler: fits tasks into free time windows by deadline and priority.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://arushi-1011.github.io/task-slotter/",
  "bugs": {
    "url": "https://github.com/Arushi-1011/task-slotter/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 types-check/check.ts"
  },
  "keywords": [
    "scheduler",
    "planner",
    "tasks",
    "time-blocking"
  ],
  "author": "Arushi Srivastava",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arushi-1011/task-slotter.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
